<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Video Surface -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Modern Floating Status Bar (Top) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#CC000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- FPS Indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_fps"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/fpsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#4CAF50"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bitrate Indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_bitrate"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/bitrateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#2196F3"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Resolution Indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_resolution"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/resolutionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FF9800"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RTT Latency Indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_rtt"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/latencyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#E91E63"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Settings Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settingsButton"
        android:contentDescription="@string/settings_open"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="24dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="#CC000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_settings"
            android:tint="#FFFFFF" />
    </androidx.cardview.widget.CardView>
    <!-- Connection panel (home screen). Hidden while streaming. -->
    <FrameLayout
        android:id="@+id/settingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/ss_bg"
        android:clickable="true"
        android:focusable="false"
        android:fitsSystemWindows="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="32dp"
            app:layout_constraintWidth_max="560dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Logo -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:src="@drawable/logo"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <!-- Header (MainActivity adds the version) -->
            <TextView
                android:id="@+id/appTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_name"
                android:textColor="@color/ss_text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_subtitle"
                android:textColor="@color/ss_text_primary"
                android:alpha="0.85"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- Companion requirement: without this, the app looks broken to anyone without a Mac -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_requires_mac"
                android:textColor="@color/ss_text_secondary"
                android:textSize="13sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/getMacAppLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/home_get_mac_app"
                android:textColor="@color/ss_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="16dp" />

            <!-- Update available (SelfUpdater); MainActivity shows it -->
            <FrameLayout
                android:id="@+id/updateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/instruction_bg"
                android:visibility="gone"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/updateTitle"
                        style="@style/SharpScreen.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="32dp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/updateBody"
                        style="@style/SharpScreen.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/updateProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/ss_accent"
                        app:trackColor="@color/ss_card_inner"
                        app:trackCornerRadius="2dp" />

                    <TextView
                        android:id="@+id/updateStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/updateButton"
                            style="@style/Widget.SharpScreen.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:textSize="15sp"
                            android:text="@string/update_action" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/updateNotesButton"
                            style="@style/Widget.SharpScreen.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/update_release_notes" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/updateDismissButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/update_dismiss"
                    android:src="@drawable/ic_close"
                    app:tint="@color/ss_text_secondary" />
            </FrameLayout>

            <!-- Mode switch: USB / Wireless (pill segmented control) -->
            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="4dp"
                android:background="@drawable/segment_track"
                android:layout_marginBottom="20dp">

                <RadioGroup
                    android:id="@+id/modeToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/modeUSB"
                        style="@style/Widget.SharpScreen.Segment"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:text="@string/mode_usb" />

                    <RadioButton
                        android:id="@+id/modeWireless"
                        style="@style/Widget.SharpScreen.Segment"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:text="@string/mode_wireless" />
                </RadioGroup>
            </FrameLayout>

            <!-- ============= USB MODE CONTENT ============= -->
            <LinearLayout
                android:id="@+id/usbModeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Connection Checklist -->
            <LinearLayout
                android:id="@+id/checklistContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:background="@drawable/instruction_bg"
                android:layout_marginBottom="20dp">

                <TextView
                    style="@style/SharpScreen.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checklist_title"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp" />

                <!-- Developer Mode Check -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/checkDeveloperMode"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_alert_circle"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:id="@+id/textDeveloperMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checklist_developer_mode"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/hintDeveloperMode"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/checklist_hint_developer_mode"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- USB Debugging Check -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/checkUsbDebugging"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_alert_circle"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:id="@+id/textUsbDebugging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checklist_usb_debugging"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/hintUsbDebugging"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/checklist_hint_usb_debugging"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- USB Connected Check -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/checkUsbConnected"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_alert_circle"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:id="@+id/textUsbConnected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checklist_usb_cable"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/hintUsbConnected"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/checklist_hint_usb_cable"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Mac Server Check -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/checkMacServer"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_alert_circle"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:id="@+id/textMacServer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checklist_mac_server"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/hintMacServer"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/checklist_hint_mac_server"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

            <!-- Connect Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                style="@style/Widget.SharpScreen.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/connect"
                android:layout_marginBottom="14dp" />

            <!-- Status Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/status_indicator"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_ready"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            </LinearLayout>
            <!-- ============= /USB MODE CONTENT ============= -->

            <!-- ============= WIRELESS MODE CONTENT ============= -->
            <LinearLayout
                android:id="@+id/wirelessModeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- State: Connecting (auto or after scan) -->
                <LinearLayout
                    android:id="@+id/wirelessConnecting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:indeterminateTint="@color/ss_accent"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/connectingLabel"
                        style="@style/SharpScreen.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wireless_connecting"
                        android:gravity="center"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/connectingSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- State 1: First-time -->
                <LinearLayout
                    android:id="@+id/wirelessFirstTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="16dp">

                    <TextView
                        style="@style/SharpScreen.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wireless_pair_title"
                        android:gravity="center"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        style="@style/SharpScreen.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wireless_pair_steps"
                        android:gravity="center"
                        android:layout_marginBottom="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessScanButton"
                        style="@style/Widget.SharpScreen.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/wireless_scan_qr" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessEnterCodeButton"
                        style="@style/Widget.SharpScreen.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/wireless_enter_code_no_camera" />
                </LinearLayout>

                <!-- State 3: Connected -->
                <LinearLayout
                    android:id="@+id/wirelessConnected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wireless_connected"
                        android:textColor="@color/ss_success"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/connectedMacName"
                        style="@style/SharpScreen.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mac"
                        android:textSize="17sp"
                        android:gravity="center"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/connectedMacIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginBottom="18dp"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessDisconnectButton"
                        style="@style/Widget.SharpScreen.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/wireless_disconnect"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessForgetButton"
                        style="@style/Widget.SharpScreen.Button.Outlined.Danger"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/wireless_forget_mac" />
                </LinearLayout>

                <!-- State: Paired idle (after explicit Disconnect) -->
                <LinearLayout
                    android:id="@+id/wirelessPairedIdle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wireless_disconnected"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/idleMacName"
                        style="@style/SharpScreen.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mac"
                        android:textSize="17sp"
                        android:gravity="center"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/idleMacIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginBottom="18dp"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessReconnectButton"
                        style="@style/Widget.SharpScreen.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/wireless_reconnect"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessIdleForgetButton"
                        style="@style/Widget.SharpScreen.Button.Outlined.Danger"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/wireless_forget_mac" />
                </LinearLayout>

                <!-- State 4: Token mismatch / re-pair -->
                <LinearLayout
                    android:id="@+id/wirelessTokenMismatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/repairTitle"
                        style="@style/SharpScreen.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wireless_repair_title"
                        android:textColor="@color/ss_warning"
                        android:gravity="center"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/repairMessage"
                        style="@style/SharpScreen.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wireless_repair_message"
                        android:gravity="center"
                        android:layout_marginBottom="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessRescanButton"
                        style="@style/Widget.SharpScreen.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/wireless_scan_qr" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessRepairEnterCodeButton"
                        style="@style/Widget.SharpScreen.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/wireless_enter_code_instead" />
                </LinearLayout>

                <!-- State 5: Permission denied permanently -->
                <LinearLayout
                    android:id="@+id/wirelessPermDenied"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/SharpScreen.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wireless_camera_title"
                        android:gravity="center"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        style="@style/SharpScreen.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wireless_camera_message"
                        android:gravity="center"
                        android:layout_marginBottom="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessOpenSettingsButton"
                        style="@style/Widget.SharpScreen.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/wireless_open_settings" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessPermDeniedEnterCodeButton"
                        style="@style/Widget.SharpScreen.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/wireless_enter_code_no_camera" />
                </LinearLayout>

            </LinearLayout>
            <!-- ============= /WIRELESS MODE CONTENT ============= -->

            <!-- Secondary actions, shared by both connection modes -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Bundled recording of a real Mac + phone session, for people without a Mac -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/watchVideoButton"
                    style="@style/Widget.SharpScreen.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_demo_video" />

                <!-- Demo mode entry -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/demoButton"
                    style="@style/Widget.SharpScreen.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/try_demo" />
            </LinearLayout>

            <!-- Somewhere to report problems that isn't a Play review -->
            <TextView
                android:id="@+id/reportProblemLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/report_problem"
                android:textColor="@color/ss_text_secondary"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Hidden disconnect button reference (needed by code) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- App settings (language, USB host/port, about) -->
        <ImageButton
            android:id="@+id/appSettingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/ss_text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_open" />
    </FrameLayout>

    <!-- Hidden log text (needed by code) -->
    <TextView
        android:id="@+id/logText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
