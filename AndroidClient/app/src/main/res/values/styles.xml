<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Text ===== -->
    <style name="TextAppearance.SharpScreen.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SharpScreen.CardTitle" parent="">
        <item name="android:textColor">@color/ss_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SharpScreen.Body" parent="">
        <item name="android:textColor">@color/ss_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Small caption above a group of settings -->
    <style name="SharpScreen.SectionCaption" parent="">
        <item name="android:textColor">@color/ss_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SharpScreen.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/ss_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Buttons ===== -->
    <!-- Primary action: coral fill, dark text -->
    <style name="Widget.SharpScreen.Button.Primary" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/accent_button_bg</item>
        <item name="android:textColor">@color/accent_button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="rippleColor">#33000000</item>
    </style>

    <!-- Secondary action: outlined, light text -->
    <style name="Widget.SharpScreen.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/ss_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/ss_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="rippleColor">#1FFFFFFF</item>
    </style>

    <style name="Widget.SharpScreen.Button.Outlined.Danger">
        <item name="android:textColor">@color/ss_danger</item>
        <item name="strokeColor">@color/ss_danger_outline</item>
        <item name="rippleColor">#1FFF8A8A</item>
    </style>

    <!-- Quiet text action in accent colour -->
    <style name="Widget.SharpScreen.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/ss_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">#1FEE7A7F</item>
    </style>

    <!-- Quiet text action in secondary grey -->
    <style name="Widget.SharpScreen.Button.Text.Quiet">
        <item name="android:textColor">@color/ss_text_secondary</item>
        <item name="rippleColor">#1FFFFFFF</item>
    </style>

    <style name="Widget.SharpScreen.Button.DialogText" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/ss_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">#1FEE7A7F</item>
    </style>

    <style name="Widget.SharpScreen.Button.DialogText.Quiet">
        <item name="android:textColor">@color/ss_text_secondary</item>
        <item name="rippleColor">#1FFFFFFF</item>
    </style>

    <!-- One segment of the USB / Wireless pill switch. android:background replaces the
         MaterialButton shape so the toggle group cannot square off the inner corners. -->
    <style name="Widget.SharpScreen.Segment" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:background">@drawable/segment_bg</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/mode_toggle_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- In-stream settings: one of the eight position buttons -->
    <style name="Widget.SharpScreen.Button.Position" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/ss_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/ss_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#1FFFFFFF</item>
    </style>

    <!-- ===== Inputs ===== -->
    <style name="Widget.SharpScreen.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_box_stroke</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/ss_accent</item>
        <item name="android:textColorHint">@color/ss_text_secondary</item>
    </style>

    <!-- ===== Shapes ===== -->
    <style name="ShapeAppearance.SharpScreen.Card" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>
</resources>
